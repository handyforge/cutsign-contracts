{
  "toleranceSeconds": 0.001,
  "merge": [
    { "name": "five adjacent pieces of one source become one", "pieces": [["a", 0.0, 3.337], ["a", 3.337, 7.123], ["a", 7.123, 11.111], ["a", 11.111, 15.555], ["a", 15.555, 20.0]], "expected": [["a", 0.0, 20.0]] },
    { "name": "gap of one tick merges", "pieces": [["a", 0.0, 3.337], ["a", 3.338, 7.0]], "expected": [["a", 0.0, 7.0]] },
    { "name": "gap of two ticks stays", "pieces": [["a", 0.0, 3.337], ["a", 3.339, 7.0]], "expected": [["a", 0.0, 3.337], ["a", 3.339, 7.0]] },
    { "name": "gap of 0.2 s stays", "pieces": [["a", 0.0, 1.0], ["a", 1.2, 2.0]], "expected": [["a", 0.0, 1.0], ["a", 1.2, 2.0]] },
    { "name": "overlap merges to the later end", "pieces": [["a", 0.0, 5.0], ["a", 4.0, 6.0]], "expected": [["a", 0.0, 6.0]] },
    { "name": "different sources never merge", "pieces": [["a", 0.0, 5.0], ["b", 5.0, 9.0]], "expected": [["a", 0.0, 5.0], ["b", 5.0, 9.0]] },
    { "name": "order is kept, only consecutive items merge", "pieces": [["b", 5.0, 9.0], ["a", 1.0, 3.0], ["a", 3.0, 4.0]], "expected": [["b", 5.0, 9.0], ["a", 1.0, 4.0]] }
  ],
  "snap": [
    { "name": "25 fps rounds to the nearest frame", "fps": "25/1", "start": 3.337, "end": 7.123, "expected": [3.32, 7.12] },
    { "name": "ntsc rational stays exact", "fps": "30000/1001", "start": 10.0, "end": 10.5, "expected": [10.01, 10.5105] },
    { "name": "unknown rate leaves bounds alone", "fps": "0/0", "start": 1.234, "end": 2.345, "expected": [1.234, 2.345] },
    { "name": "missing rate leaves bounds alone", "fps": null, "start": 1.234, "end": 2.345, "expected": [1.234, 2.345] },
    { "name": "piece shorter than a frame keeps one frame", "fps": "25/1", "start": 1.001, "end": 1.015, "expected": [1.0, 1.04] }
  ],
  "frameRate": [
    { "avg_frame_rate": "30000/1001", "r_frame_rate": "30000/1001", "expected": 29.97002997002997 },
    { "avg_frame_rate": "0/0", "r_frame_rate": "25/1", "expected": 25.0 },
    { "avg_frame_rate": null, "r_frame_rate": null, "expected": 0.0 }
  ]
}
